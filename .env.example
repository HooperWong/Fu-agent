# 环境变量模板 —— 复制为 .env 后填写真实值（.env 不提交 git）
# 在终端执行：copy .env.example .env  (Windows) / cp .env.example .env

# ===== WOLAI =====
WOLAI_TOKEN=
WOLAI_MCP_URL=https://api.wolai.com/v1/mcp

# ===== SAP（arc-1 MCP）=====
SAP_QAS300_URL=
SAP_QAS300_CLIENT=
SAP_QAS300_LANG=ZH
SAP_QAS300_USER=
SAP_QAS300_PASSWORD=
SAP_QAS300_ALLOW_WRITES=false

# ===== 模型渠道（按需填写，也可在应用界面配置）=====
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=

# ===== 数据目录（可选，默认使用仓库内 data/）=====
# PROMA_DATA_DIR=
